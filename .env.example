# ─────────────────────────────────────────────────────────────────────────────
# 폴릿(Polit) 환경변수 템플릿
# cp .env.example .env 후 각 값을 실제 값으로 변경하세요.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME="Polit"
APP_ENV=local
APP_KEY=                          # php artisan key:generate 로 자동 생성
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul
APP_URL=http://localhost
APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=ko_KR

# Docker 포트 매핑
APP_PORT=80
APP_SSL_PORT=443

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────
# Database (PostgreSQL 16)
# ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres          # Docker 서비스명 (컨테이너 내부 통신)
DB_PORT=5432              # 컨테이너 내부 포트 (변경 불필요)
FORWARD_DB_PORT=5433      # 호스트 노출 포트 (로컬 PG 5432와 충돌 방지)
DB_DATABASE=polit
DB_USERNAME=polit
DB_PASSWORD=secret        # 운영 환경에서는 강력한 패스워드로 변경

# ─────────────────────────────────────────
# Cache / Queue / Session (Redis)
# ─────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120      # 분 단위

REDIS_HOST=redis          # Docker 서비스명
REDIS_PASSWORD=secret     # 운영 환경에서는 강력한 패스워드로 변경
REDIS_PORT=6379

# Redis DB 분리 (용도별 충돌 방지)
REDIS_DB=0                # 기본 캐시
REDIS_QUEUE_DB=1          # 큐
REDIS_SESSION_DB=2        # 세션

# ─────────────────────────────────────────
# Mail (로컬: Mailpit, 운영: SMTP)
# ─────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit         # 로컬: Docker Mailpit / 운영: smtp.gmail.com 등
MAIL_PORT=1025            # 로컬: 1025 / 운영: 587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null      # 운영: tls
MAIL_FROM_ADDRESS="noreply@polit.kr"
MAIL_FROM_NAME="${APP_NAME}"

MAILPIT_UI_PORT=8025

# ─────────────────────────────────────────
# Laravel Reverb (WebSocket)
# ─────────────────────────────────────────
REVERB_APP_ID=polit-app
REVERB_APP_KEY=polit-key
REVERB_APP_SECRET=polit-secret   # 운영 환경에서는 강력한 시크릿으로 변경
REVERB_HOST=reverb               # Docker 서비스명
REVERB_PORT=8080
REVERB_SCHEME=http               # 운영: https

# 프론트엔드 클라이언트 설정
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${APP_URL}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─────────────────────────────────────────
# Sanctum (API 인증)
# ─────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

# ─────────────────────────────────────────
# 소셜 로그인
# ─────────────────────────────────────────
# 카카오 — https://developers.kakao.com
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI="${APP_URL}/auth/kakao/callback"

# 네이버 — https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI="${APP_URL}/auth/naver/callback"

# 구글 — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─────────────────────────────────────────
# Filesystem
# ─────────────────────────────────────────
FILESYSTEM_DISK=local
# 운영 환경: s3 (AWS S3 또는 NCP Object Storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-2
# AWS_BUCKET=polit-uploads
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────
# Sail (Docker 전용)
# ─────────────────────────────────────────
WWWUSER=1000
WWWGROUP=1000
SAIL_XDEBUG_MODE=off

# ─────────────────────────────────────────
# Telescope (디버깅, 로컬 전용)
# ─────────────────────────────────────────
TELESCOPE_ENABLED=true

# ─────────────────────────────────────────
# L5-Swagger (API 문서)
# ─────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true   # 개발: true / 운영: false
