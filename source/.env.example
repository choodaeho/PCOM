# ─────────────────────────────────────────────────────────────────────────────
# 폴릿(Polit) 환경변수 템플릿
# 사용법: cp .env.example .env  →  .env 파일에서 실제 값으로 변경
#
# ⚠️  주의: dotenv 파일은 값 뒤에 인라인 주석(# ...)을 쓰면 안 됩니다.
#     Docker Compose와 PHP dotenv가 다르게 파싱하여 인증 오류가 발생합니다.
#     설명은 반드시 별도 줄에 # 으로 작성하세요.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME="Polit"
APP_ENV=local
# APP_KEY는 make install 시 php artisan key:generate 로 자동 생성됩니다
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul
APP_URL=http://localhost
APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=ko_KR

# Docker 포트 매핑
APP_PORT=80
APP_SSL_PORT=443

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────
# Database (PostgreSQL 16)
# DB_HOST: Docker 서비스명 (컨테이너 내부 통신용, 변경 불필요)
# DB_PORT: 컨테이너 내부 포트 (변경 불필요)
# FORWARD_DB_PORT: 호스트 노출 포트 (로컬 PG 5432와 충돌 시 5433 사용)
# DB_PASSWORD: 운영 환경에서는 반드시 강력한 패스워드로 변경
# ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
FORWARD_DB_PORT=5433
DB_DATABASE=polit
DB_USERNAME=polit
DB_PASSWORD=secret

# ─────────────────────────────────────────
# Cache / Queue / Session (Redis)
# REDIS_HOST: Docker 서비스명 (변경 불필요)
# SESSION_LIFETIME: 분 단위
# ─────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

# Redis DB 분리 (용도별 충돌 방지)
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_SESSION_DB=2

# ─────────────────────────────────────────
# Mail
# 로컬: MAIL_HOST=mailpit, MAIL_PORT=1025, MAIL_ENCRYPTION=null
# 운영: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
# ─────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@polit.kr"
MAIL_FROM_NAME="${APP_NAME}"

MAILPIT_UI_PORT=8025

# ─────────────────────────────────────────
# Laravel Reverb (WebSocket)
# REVERB_HOST: Docker 서비스명 (변경 불필요)
# REVERB_SCHEME: 운영 환경에서는 https 로 변경
# ─────────────────────────────────────────
REVERB_APP_ID=polit-app
REVERB_APP_KEY=polit-key
REVERB_APP_SECRET=polit-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ─────────────────────────────────────────
# Inertia SSR (Server-Side Rendering)
# 로컬 Docker: http://ssr:13714 (컨테이너 서비스명)
# 로컬 직접 실행: http://127.0.0.1:13714
# ─────────────────────────────────────────
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

# ─────────────────────────────────────────
# 프론트엔드 개발 서버 (Vite)
# VITE_PORT: docker-compose.yml 포트와 일치해야 함
# VITE_HMR_HOST: WSL2=localhost, VM=IP 주소
# ─────────────────────────────────────────
VITE_PORT=5173
VITE_HMR_HOST=localhost

# 프론트엔드 클라이언트 Reverb 설정
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${APP_URL}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─────────────────────────────────────────
# Sanctum (API 인증)
# ─────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

# ─────────────────────────────────────────
# 소셜 로그인
# 카카오: https://developers.kakao.com
# 네이버: https://developers.naver.com
# 구글: https://console.cloud.google.com
# ─────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI="${APP_URL}/auth/kakao/callback"

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI="${APP_URL}/auth/naver/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─────────────────────────────────────────
# Filesystem
# 운영 환경: FILESYSTEM_DISK=s3 (AWS S3 또는 NCP Object Storage)
# ─────────────────────────────────────────
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-2
# AWS_BUCKET=polit-uploads
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────
# Sail (Docker 전용)
# ─────────────────────────────────────────
WWWUSER=1000
WWWGROUP=1000
SAIL_XDEBUG_MODE=off

# ─────────────────────────────────────────
# Telescope (디버깅, 로컬 전용)
# ─────────────────────────────────────────
TELESCOPE_ENABLED=true

# ─────────────────────────────────────────
# L5-Swagger (API 문서)
# 개발: true / 운영: false
# ─────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true
