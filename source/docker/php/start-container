#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# start-container — Polit app 컨테이너 진입점 스크립트
#
# 두 가지 모드를 지원합니다:
#   1. 서비스 모드 (인자 없음): supervisord → PHP-FPM 시작
#   2. 일회성 커맨드 모드 (인자 있음): 해당 명령어만 실행 후 종료
#      예) docker compose run --rm app composer install
#          docker compose run --rm app php artisan migrate
# ─────────────────────────────────────────────────────────────────────────────
set -e

# ─────────────────────────────────────────────
# 호스트 UID와 sail 사용자 UID 동기화
# (볼륨 마운트 파일의 권한 문제 방지)
# ─────────────────────────────────────────────
if [ -n "$WWWUSER" ]; then
    usermod -u "$WWWUSER" sail 2>/dev/null || true
fi

# ─────────────────────────────────────────────
# 로그 디렉터리 보장
# ─────────────────────────────────────────────
mkdir -p /var/log/supervisor

# ─────────────────────────────────────────────
# 커맨드 인자가 있으면 해당 명령어 실행 (일회성 모드)
# gosu 를 통해 sail 유저로 실행하여 생성된 파일 권한을 일관되게 유지
# ─────────────────────────────────────────────
if [ $# -gt 0 ]; then
    exec gosu sail "$@"
fi

# ─────────────────────────────────────────────
# 기본: supervisord 시작 (PHP-FPM 관리)
# ─────────────────────────────────────────────
exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
